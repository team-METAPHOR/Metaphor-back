APP_NAME=Metaphor API
DEBUG=false
DATABASE_URL=postgresql+psycopg://metaphor:metaphor@localhost:5432/metaphor
STORAGE_ROOT=var/storage
ALLOWED_ORIGINS=["http://localhost:3000"]
# REQUIRED. HMAC key (>= 32 bytes) for login emails and client IPs (only hashes are stored).
# Missing/short → the API refuses to start, unless DEBUG=true and it is empty (dev-only key).
# Rotating it resets rate-limit windows and old audit hashes stop matching new ones.
# Generate: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
IP_HASH_SECRET=
# Reverse proxies (IPs/CIDRs) allowed to set X-Forwarded-For. Empty → the TCP peer is the client.
# REQUIRED behind a reverse proxy/load balancer: otherwise every client shares the proxy IP and
# per-IP limits (signup 5/h, widget 10/h) become a global lockout. The API logs a warning once
# when it sees X-Forwarded-For from an unlisted peer.
# Only list proxies you run; the right-most XFF hop not in this list is used as the client IP.
TRUSTED_PROXIES=[]
# RSA (>= 3072-bit) public key PEM that seals program test accounts (not secret; use \n for
# newlines on one line). Generate with `uv run python -m app.worker.keys <dir>`. Empty → PUT
# /programs/{id}/test-account returns 503. The private key goes ONLY in the worker env as
# TEST_ACCOUNT_PRIVATE_KEY, never here.
TEST_ACCOUNT_PUBLIC_KEY=

# --- Worker only (`uv run python -m app.worker.main`). Never put these in the API env. ---
# Primary model.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# Optional plan critic. Empty → off. If set but the key/model is invalid, jobs fail with
# CRITIC_CONFIG_INVALID (never a silent single-model run).
# QA_CRITIC_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=
# Masked reproduction video. Off unless 1/true/yes/on.
# QA_VIDEO_ENABLED=false
# Optional ffmpeg path; usually unnecessary (the worker extra bundles imageio-ffmpeg).
# FFMPEG_BINARY=
# Private key matching TEST_ACCOUNT_PUBLIC_KEY; only the worker can open test accounts.
# TEST_ACCOUNT_PRIVATE_KEY=
# Test session headers per org/ref, JSON object: QA_SESSION_<ORG_ID>_<REF>={"Authorization": "..."}
