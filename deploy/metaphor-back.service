[Unit]
Description=Metaphor Backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=exec
User=ubuntu
WorkingDirectory=/home/ubuntu/metaphor-back
Environment="PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# The API reads .env through Settings; never load .env.worker here.
ExecStart=/home/ubuntu/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
